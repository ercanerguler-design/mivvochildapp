# Neon DB (PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/mivvo?sslmode=require

# NextAuth.js v5
AUTH_SECRET=your_super_secret_min_32_chars_here
AUTH_URL=http://localhost:3000

# OAuth Providers (opsiyonel)
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google Console -> Authorized redirect URI:
# https://mivvochildapp.vercel.app/api/auth/callback/google

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Cloud Messaging (Flutter push notifications için)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@project.iam.gserviceaccount.com

# Mobile API key (Flutter uygulaması için — rastgele güçlü string gir)
MOBILE_API_KEY=your_very_long_random_secret_here

# Landing page app download links (QR kod bu linkleri acacak)
NEXT_PUBLIC_SITE_URL=https://mivvo.org
NEXT_PUBLIC_CHILD_APK_URL=/api/download/child
NEXT_PUBLIC_PARENT_APK_URL=/api/download/parent
# Opsiyonel: APK dosya yolunu override etmek için
# CHILD_APK_FILE_PATH=public/apk/mivvo-child-latest.apk
# PARENT_APK_FILE_PATH=public/apk/mivvo-parent-latest.apk

# Admin panel key (kredi yukleme icin)
ADMIN_PANEL_KEY=change_me_admin_secret

# Iyzico (yakinda aktif edilecek)
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Relaunch (2026-10) ---
# Google Play links
NEXT_PUBLIC_PARENT_PLAY_URL=https://play.google.com/store/apps/details?id=org.mivvo.parent
# After the child app is approved on Play, point this at its Play listing instead of the APK:
# NEXT_PUBLIC_CHILD_APK_URL=https://play.google.com/store/apps/details?id=org.mivvo.child
NEXT_PUBLIC_MONTHLY_PLAN_TL=299
NEXT_PUBLIC_FREE_TRIAL_DAYS=14

# Child device tokens (defaults to AUTH_SECRET when unset)
# DEVICE_TOKEN_SECRET=long_random_secret
# Set to true once every child device runs app 2.0.0+ (rejects the old embedded key)
MOBILE_LEGACY_KEY_DISABLED=false

# iyzico: use https://api.iyzipay.com in production
# IYZICO_DEFAULT_IDENTITY_NUMBER=11111111111
